# Resend (https://resend.com) — necessário para o formulário de contato enviar e-mails de verdade.
RESEND_API_KEY=

# E-mail que recebe as mensagens do formulário de contato.
CONTACT_TO_EMAIL=contato@centraengenharia.com.br

# Remetente usado ao enviar o e-mail (precisa ser um domínio verificado no Resend em produção).
CONTACT_FROM_EMAIL=Site Centra <onboarding@resend.dev>

# GA4 — ID de medição (formato G-XXXXXXXXXX). Enquanto estiver vazio,
# nenhum script de analytics é carregado. É NEXT_PUBLIC_*, ou seja,
# embutido no build: definir na Vercel exige um novo deploy para valer.
NEXT_PUBLIC_GA_ID=
